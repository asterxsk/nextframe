# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# dependencies and build output
web/node_modules/
web/dist/

# python
__pycache__/
*.pyc

# the zipped MovieLens download; the extracted csvs next to it are committed
data/raw/*.zip

# the hairline figure's render artifacts, reproducible with look.mjs
web/figures/hairline-*.png

# deck: the render PNGs and the generated TTFs are reproducible with
# deck/build_deck.py and deck/build_fonts.py; the pptx and pdf are the deliverable
deck/render/
deck/fonts/
